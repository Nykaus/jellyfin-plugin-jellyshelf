<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.JellyShelf</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.JellyShelf</AssemblyName>
    <AssemblyVersion>1.5.0.0</AssemblyVersion>
    <FileVersion>1.5.0.0</FileVersion>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude the local-only dev test harness (gitignored) from the plugin build. -->
    <Compile Remove="_localtest\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Match this version to your Jellyfin server version.
         Jellyfin 12.x  => Jellyfin.Controller 12.x  (net10.0).
         Jellyfin 10.11.x => Jellyfin.Controller 10.11.x (net8.0).
         Jellyfin 10.10.x => Jellyfin.Controller 10.10.x (net8.0). -->
    <PackageReference Include="Jellyfin.Controller" Version="12.3.0" />

    <!-- Microsoft.Data.Sqlite is already loaded by the Jellyfin host (it uses it
         for its own database). We compile against it but do NOT ship a copy, to
         avoid an assembly version conflict at load time.
         If the plugin fails to load with a "could not load Microsoft.Data.Sqlite"
         error, remove the <ExcludeAssets> line below to bundle it instead. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>

    <!-- Reads comic archives (CBZ/ZIP and CBR/RAR, also 7z/tar) for the reader.
         GeneratePathProperty lets us copy just these two runtime DLLs into the
         plugin folder (a plain build doesn't copy package deps, and the host does
         not provide SharpCompress). ZstdSharp is SharpCompress's own dependency. -->
    <PackageReference Include="SharpCompress" Version="0.38.0" GeneratePathProperty="true" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.1" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(PkgSharpCompress)\lib\net8.0\SharpCompress.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(PkgZstdSharp_Port)\lib\net8.0\ZstdSharp.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

  <ItemGroup>
    <!-- The in-browser reader web app (HTML/JS/CSS + vendored pdf.js), embedded
         under the "jellyshelf-web/" logical-name prefix that ReaderAssets reads. -->
    <EmbeddedResource Include="web\**\*">
      <LogicalName>jellyshelf-web/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
